
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AdminLayout";
}
@using System.Security.Claims
@{
    var fullName = User.FindFirstValue("FullName");
    var email = User.FindFirstValue("Email");
    var imagePath = User.FindFirstValue("ImagePath");
    var role = User.FindFirstValue(ClaimTypes.Role);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />


    <!-- font awesome cdn link  -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" />

    <!-- custom css file link  -->

    <title>@ViewData["Title"] - ElearningWebsite</title>
    <script type="importmap"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElearningWebsite.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdminLayout/css/style.css" />
    <link rel="stylesheet" href="~/AdminLayout/css/ManagerLayout.css" />
    <link rel="stylesheet" href="~/AdminLayout/css/DashBoardForCourse.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="~/AdminLayout/css/Modal.css" />
    <link rel="stylesheet" href="~/AdminLayout/css/site.css" />
    <link rel="stylesheet" href="~/AdminLayout/css/popup.css" />
    <link rel="stylesheet" href="~/AdminLayout/js/popup.js" />
   
</head>



<body>

    @if (TempData.ContainsKey("SuccessMessage"))
    {
        <div id="customAlert" class="modern-alert success">
            <div class="alert-icon">
                <span>✔</span>
            </div>
            <div class="alert-content">
                <strong>Success</strong>
                <p>@TempData["SuccessMessage"]</p>
            </div>
            <div class="alert-close" onclick="this.parentElement.remove()">×</div>
        </div>
    }

    @if (TempData.ContainsKey("Error"))
    {
        <div id="customAlertError" class="modern-alert error">
            <div class="alert-icon">
                <span>⚠</span>
            </div>
            <div class="alert-content">
                <strong>Error</strong>
                <p>@TempData["Error"]</p>
            </div>
            <div class="alert-close" onclick="this.parentElement.remove()">×</div>
        </div>
    }



    <header class="header">
        <section class="flex">
            <a href="home.html" class="logo">
                <i class="fa-solid fa-book-open" style="margin-right: 10px"></i>
                SmartLearn
            </a>

            <form action="search.html" method="post" class="search-form">
                <input type="text"
                       name="search_box"
                       required
                       placeholder="search courses..."
                       maxlength="100" />
                <button type="submit" class="fas fa-search"></button>
            </form>

            <div class="icons">
                <div id="menu-btn" class="fas fa-bars"></div>
                <div id="search-btn" class="fas fa-search"></div>
                <div id="user-btn" class="fas fa-user"></div>
                <div id="toggle-btn" class="fas fa-sun"></div>
            </div>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="profile">
                    @if (imagePath != null)
                    {
                        <img src="~/@imagePath" class="image" alt="" />
                    }
                    else
                    {
                        <img src="~/UserLayout/images/pic-1.jpg" class="image" alt="" />
                    }
                    <h3 class="name">@fullName</h3>            
                        <p class="role">Admin</p>
                        <a asp-action="Logout" asp-controller="AccountsManager" class="option-btn">Logout</a>
                    


                </div>
            }
        </section>
    </header>
    <div class="side-bar">
        <div id="close-btn">
            <i class="fas fa-times"></i>
        </div>
        @if (User.Identity.IsAuthenticated)
        {
            <div class="profile">
                @if (imagePath != null)
                {
                    <img src="~/@imagePath" class="image" alt="" />
                }
                else
                {
                    <img src="~/UserLayout/images/pic-1.jpg" class="image" alt="" />
                }
                <h3 class="name">@fullName</h3>
                <p class="email">@email</p>
                @if (role == "0") // Hoặc userType == "Student"
                {
                    <p class="role">Student</p>
                }
                @if (role == "1")
                {
                    <p class="role">Admin</p>
                }
            </div>
        }


        <nav class="navbar">
            <a asp-controller="Statistical" asp-action="Statistical">
                <i class="fa-solid fa-house"></i><span>DashBoard</span>
            </a>
            <a asp-controller="AccountsManager" asp-action="Index">
                <i class="fas fa-user-circle"></i><span>Accounts</span>
            </a>
            <a asp-controller="StudentsManager" asp-action="Index">
                <i class="fa-solid fa-graduation-cap"></i><span>Students</span>
            </a>
            <a asp-controller="EnrollmentManager" asp-action="Index">
                <i class="fas fa-clipboard-list"></i><span>Enrollment</span>
            </a>
            <a asp-controller="CoursesManager" asp-action="Index">
                <i class="fas fa-graduation-cap"></i><span>Courses</span>
            </a>
        </nav>

    </div>
    @RenderBody()
    <!-- custom js file link  -->
    <script src="~/UserLayout/js/script.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
