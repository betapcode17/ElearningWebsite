@model IPagedList<ElearningWebsite.Models.Student>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using X.PagedList
@using X.PagedList.Mvc.Core
@using ElearningWebsite.Models

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout.cshtml";
    
}
<link rel="stylesheet" href="~/AdminLayout/css/popup.css" />
<script src="~/AdminLayout/js/popup.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-KyZXEJcQJYf4g9J9fX6N6gM99bEJXa46s88K+EJpS5yOwD1K3gGfv5yJ+fiGH5S1" crossorigin="anonymous">


    <div class="enroll-container">
        <h1 class="heading">Accounts Manager</h1>

        <div class="enroll-body shadow-sm p-4 bg-white rounded">
            <div class="enroll-search d-flex justify-content-between align-items-center mb-4 flex-wrap">
                <form asp-action="Index" method="get" class="d-flex align-items-center enroll-search-form">
                    <input type="text" name="searchValue" class="form-control enroll-input" placeholder="Search..." value="@ViewBag.SearchValue" />
                    <button type="submit" class="btn btn-primary enroll-search-btn ms-2">
                        <i class="fas fa-search"></i>
                    </button>
                </form>

                <a asp-action="Create" class="btn btn-success ms-2 mt-2 mt-md-0 d-flex align-items-center">
                    <i class="fas fa-user-plus me-2"></i> Add Student
                </a>
            </div>

            <div class="enroll-table-wrapper table-responsive">
                <table class="table table-bordered table-hover enroll-table">
                    <thead class="table-dark">
                        <tr>

                            <th>FULLNAME</th>
                            <th>DATE OF BIRTH</th>
                            <th>EMAIL</th>
                            <th>PHONE NUMBER</th>
                            <th>GENDER</th>
                            <th>PROFILE IMAGE</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.FullName</td>
                                <td>@item.DateOfBirth.ToString("yyyy-MM-dd")</td>
                                <td>@item.Email</td>
                                <td>@item.PhoneNumber</td>
                                <td>
                                    @if (item.Gender == 0)
                                    {
                                        <span>Male</span>
                                    }
                                    else if (item.Gender == 1)
                                    {
                                        <span>Female</span>
                                    }
                                    else
                                    {
                                        <span>Other</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="~/@item.ImagePath" alt="Profile Image" class="profile-img" />
                                    }
                                    else
                                    {
                                        <span>No Image</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.StudentId" class="btn btn-sm btn-outline-primary me-1" title="Chỉnh sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="openPopup('@item.StudentId')">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div id="popup-overlay" class="popup-overlay">
                    <div class="popup-box modern">
                        <button type="button" class="close-btn" onclick="closePopup()">×</button>
                        <div class="check-icon">⚠</div>
                        <h2>Delete this student?</h2>
                        <p>You are about to delete this student. This action cannot be undone.</p>
                        <form id="deleteForm" method="post" asp-action="Delete">
                            <input type="hidden" name="id" id="popup-course-id" />
                            <div class="popup-actions">
                                <button type="button" class="cancel-btn" onclick="closePopup()">Cancel</button>
                                <button type="submit" class="confirm-btn">Yes, Delete</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="enroll-pagination d-flex justify-content-center mt-4">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Index", new { page = Model.PageNumber - 1, searchValue = ViewBag.SearchValue })"
                       class="enroll-page-link">«</a>
                }
                @for (int i = 1; i <= Model.PageCount; i++)
                {
                    <a href="@Url.Action("Index", new { page = i, searchValue = ViewBag.SearchValue })"
                       class="enroll-page-link @(i == Model.PageNumber ? "active" : "")">@i</a>
                }
                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Index", new { page = Model.PageNumber + 1, searchValue = ViewBag.SearchValue })"
                       class="enroll-page-link">»</a>
                }
            </div>
        </div>
    </div>
