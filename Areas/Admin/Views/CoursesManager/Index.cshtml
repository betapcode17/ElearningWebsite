@using X.PagedList
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IPagedList<ElearningWebsite.Models.Course>
@using X.PagedList.Mvc.Core;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout.cshtml";
}

<section class="playlists">
    <h1 class="heading">Course Manager</h1>

    <div class="box-container">
        <div class="box" style="text-align: center">
            <h3 class="title" style="margin-bottom: 0.5rem">
                create new Course
            </h3>
            <a asp-action="Create" asp-controller="CoursesManager" class="btn">add Courses</a>
        </div>

        <!-- Ví dụ một playlist tĩnh để minh họa -->
      
        @foreach(var course in Model){
            <div class="box">
                <div class="flex">
                    <div><i class="fas fa-calendar"></i><span>@course.StartDate</span></div>
                </div>
                <div class="thumb">
                    <span>@course.VideoCount</span>
                    <img src="~/@course.ImgPath" alt="" />
                </div>
                <h3 class="title">@course.CourseName</h3>
                <p class="description">
                  @course.Description
                </p>
                <ul class="course-info">
                    <li>
                        <p>Tuition Fee</p>
                        <p class="value-box">@course.TuitionFee</p>
                    </li>
                    <li>
                        <p>Enrolled</p>
                        <p class="value-box">
                            <span class="enrolled">@course.CurrentStudents</span> / <span class="max">@course.MaxStudents</span>
                        </p>
                    </li>
                </ul>
                

                   
                    <a asp-action="Edit"
                       asp-controller="CoursesManager"
                       asp-route-id="@course.CourseId"
                       class="option-btn">Edit</a>


                <button type="button"
                        class="delete-btn"
                        onclick="openPopup('@course.CourseId')">
                    Delete
                </button>

               
                 
                <a asp-action="Details"
                   asp-controller="CoursesManager"
                   asp-route-id="@course.CourseId"
                   class="btn">View Playlist</a>

            </div>
        }
       <div id="popup-overlay" class="popup-overlay">
            <div class="popup-box modern">
                <div class="check-icon">✔</div>
                <h2>Delete this course?</h2>
                <p>You are about to delete this course. This action cannot be undone.</p>
                <form id="deleteForm" method="post" asp-action="Delete" asp-controller="CoursesManager">
                    <input type="hidden" name="id" id="popup-course-id" />
                    <div class="popup-actions">
                        <button type="button" class="cancel-btn" onclick="closePopup()">Cancel</button>
                        <button type="submit" class="confirm-btn">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    </div>
</section>
<div class="pagination">
    @Html.PagedListPager(Model, page => Url.Action("Index", new
        {
            page,
            search_box = ViewBag.CurrentFilter 
        }))
</div>
@section Scripts {
    <script>
     
        function openPopup(courseId) {
         
            document.getElementById('popup-course-id').value = courseId;
          
            document.getElementById('popup-overlay').style.display = 'flex';
        }

       
        function closePopup() {
          
            document.getElementById('popup-overlay').style.display = 'none';
         
            document.getElementById('popup-course-id').value = '';
        }
    </script>
}