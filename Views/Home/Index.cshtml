@model List<Course>
@{
    ViewData["Title"] = "Home Page";
}


<section class="courses">
    <h1 class="heading">our courses</h1>

    <div class="box-container">
       @foreach(var course in Model){
            <div class="box">
                <div class="tutor">
                    <img src="~/UserLayout/images/pic-1.jpg" alt="" />
                    <div class="info">
                        <h3>@course.Instructor</h3>
                    </div>
                </div>
                <div class="thumb">
                    <img src="~/@course.ImgPath" alt="" />
                    <span>10 videos</span>
                </div>
                <h3 class="title">@course.CourseName</h3>
                <ul class="course-info">
                    <li>
                        <p>Start Date</p>
                        <p class="value-box">@course.StartDate</p>
                    </li>
                    <li>
                        <p>Tuition Fee</p>
                        <p class="value-box">@course.TuitionFee</p>
                    </li>
                    <li>
                        <p>Enrolled</p>
                        <p class="value-box">
                            <span class="enrolled">@course.CurrentStudents</span> / <span class="max">@course.MaxStudents</span>
                        </p>
                    </li>
                </ul>

                <a asp-action="Details" asp-controller="Courses" asp-route-id="@course.CourseId" class="inline-btn"> View course</a>
            </div>
       }
    </div>
    <div class="more-btn">
        <a asp-action="Index" asp-controller="Courses" class="inline-option-btn">view all courses</a>
    </div>
</section>
