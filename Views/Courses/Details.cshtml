@model ElearningWebsite.Models.Course
@{
    ViewData["Title"] = "Details";
    Layout = "_LayoutUser";
}

<section class="playlist-details">
    <h1 class="heading">Courses details</h1>

    <div class="row">
        <div class="column">
            <form action="" method="post" class="save-playlist">
                <button type="submit">
                    <i class="far fa-bookmark"></i> <span>save playlist</span>
                </button>
            </form>
            <div class="thumb">
                <img src="~/@Model.ImgPath" alt="" />
                <span>@Model.VideoCount videos</span>
            </div>
        </div>
        <div class="column">
            <div class="tutor">
                <img src="images/pic-2.jpg" alt="" />
                <div>
                    <h3>@Model.Instructor</h3>
                </div>
            </div>

            <div class="thumb">
                <h1 class="title">@Model.CourseName</h1>
                <ul class="course-info">
                    <li>
                        <p>Start Date</p>
                        <p class="value-box">@Model.StartDate</p>
                    </li>
                    <li>
                        <p>Tuition Fee</p>
                        <p class="value-box">@Model.TuitionFee VND</p>
                    </li>
                    <li>
                        <p>Enrolled</p>
                        <p class="value-box">
                            @Model.CurrentStudents/@Model.MaxStudents
                        </p>
                    </li>
                    @if (ViewBag.IsEnrolled)
                    {
                        <li>
                          
                            <div class="progress-container">
                                <div class="progress-bar" style="width: @ViewBag.Progress%">@ViewBag.Progress%</div>
                            </div>
                        </li>
                    }
                </ul>
                <p>
                    @Model.Description
                </p>
                @if (!ViewBag.IsEnrolled)
                {
                    <form asp-action="RegisterCourse" asp-controller="Enrollment" method="post">
                        <input type="hidden" name="id" value="@Model.CourseId" />
                        <button type="submit" class="inline-btn">Register Now</button>
                    </form>
                }

            </div>
        </div>
    </div>
</section>


<section class="playlist-videos">
    <h1 class="heading">playlist videos</h1>
    <div class="box-container">
        @for (int i = 1; i <= Model.VideoCount; i++)
        {
            <a class="box" asp-action="WatchVideo" asp-controller="Courses" asp-route-courseId="@Model.CourseId" asp-route-videoIndex="@i">
                <i class="fas fa-play"></i>
                <img src="~/@Model.ImgPath" alt="" />
                <h3>@Model.CourseName (part @i)</h3>
            </a>
        }
    </div>
</section>


   


